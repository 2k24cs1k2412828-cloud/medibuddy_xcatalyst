# ==============================================================================
# MediCare Connect - Environment Configuration Template
# Configure these variables in your Vercel Project Settings -> Environment Variables.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Supabase Public Configuration (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Server-Only Service Role Key (Bypasses RLS - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=

# High-entropy random secret for HMAC-SHA256 Patient Kiosk Session verification
KIOSK_SESSION_SECRET=

# High-entropy random secret Bearer token for /api/cron/process-reminders
CRON_SECRET=

# Resend Transactional Email API Key (re_...)
RESEND_API_KEY=

# Verified Resend Sender Email Address
RESEND_FROM_EMAIL=
